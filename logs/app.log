			<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top; width:340px;'>
				<div class='notes-par'>
					<span class='notes-field-wrap'>
						<span class='notes-field' data-field='WorkTime' data-type='number'>300</span>
					</span>
					<span style='font-weight:bold;'>　分</span>
				</div>
