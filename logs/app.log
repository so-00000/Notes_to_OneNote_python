			<span class='notes-field' data-field='Detail_1' data-type='richtext' data-kind='editable'><div id='seg-006' data-id='seg-006'>&nbsp;</div>
<p><br/></p></span>
		</span>
	</div>
	<br/>
	<div class='notes-par'>
		<span style='font-weight:bold;'>親文書</span>
	</div>
	<br/>
	<div class='notes-par'>
		<span class='notes-field-wrap'>
			<span class='notes-field' data-field='Fd_Link_1' data-type='richtext' data-kind='computed'><p><br/></p></span>
		</span>
	</div>
	<table style='margin-top:1em; border-collapse:collapse; width:800px; table-layout:fixed;' width='800' border='1' cellspacing='0' cellpadding='0' data-hidewhen='@IsNotMember(Division;&quot;障害&quot;)'>
