			<span class='notes-field' data-field='Detail_1' data-type='richtext'><div id='seg-001' data-id='seg-001'><img src='name:p1' style='max-width:100%; width:987px; height:536px;'/></div>
<p><br/></p></span>
		</span>
	</div>
	<br/>
	<div class='notes-par'>
		<span style='font-weight:bold;'>親文書</span>
	</div>
	<br/>
	<div class='notes-par'>
