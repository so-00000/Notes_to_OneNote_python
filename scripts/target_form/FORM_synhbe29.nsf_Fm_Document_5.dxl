<tablecell>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> </run></par></tablecell></tablerow>
<tablerow>
<tablecell bgcolor='#ffe1b0'>
<par def='10'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> 申請者</run></par></tablecell>
<tablecell>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> ロール:</run><run><font size='9pt' color='red' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30'/><field type='text' kind='computedwhencomposed'
 name='ApplicantRole'><code event='defaultvalue'><formula>List := "[Leader1]":"[Leader2]":"[Leader3]":"[Leader4]":"[Leader5]":"[Group1]":"[Group2]":"[Group3]":"[Group4]":"[Group5]":"[Director1]":"[Director2]":"[Director3]":"[Director4]":"[Director5]";
Cnt := @Elements(List);
@For(i := 1;i &lt;= Cnt;i := i + 1;
        @If(@IsMember(List[i];@UserRoles);@Return(List[i]);""));

""</formula></code></field></run><compositedata type='98' prevtype='65418'
 nexttype='222' afterparcount='9' containertype='65418' aftercontainercount='1'
 afterbegincount='3'>
Yg4BAIQAAAAAAAAAAAA=
</compositedata><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/></run></par>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> </run><run><font size='9pt' color='red' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30'/><field type='names' allowmultivalues='true'
 kind='computed' name='ApplicantUser' listinputseparators='comma semicolon'
 listdisplayseparator='comma'><code event='defaultvalue'><formula>Author</formula></code></field></run><run
><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30'
 color='red'/></run></par></tablecell></tablerow>
<tablerow>
<tablecell bgcolor='#ffe1b0'>
<par def='10'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> 承認者</run></par></tablecell>
<tablecell>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> ロール:</run><run><font size='9pt' color='red' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30'/><field type='text' kind='computed'
 name='ApproverRole'><code event='defaultvalue'><formula>No := @Left(@Right(ApplicantRole;2);1);

@If(ApplicantRole="";"";
     @Contains(ApplicantRole;"Director");"[Director" + No + "]";
     @Contains(ApplicantRole;"Leader");"[Director" + No + "]";
     @Contains(ApplicantRole;"Group");"[Leader" + No + "]";
     "")</formula></code></field></run><compositedata type='98' prevtype='65418'
 nexttype='222' afterparcount='9' containertype='65418' aftercontainercount='1'
 afterbegincount='3'>
Yg4BAIQAAAAAAAAAAAA=
</compositedata><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/></run></par>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> </run><run><font size='9pt' color='red' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30'/><field type='names' allowmultivalues='true'
 kind='computed' name='ApproverUser' listinputseparators='comma semicolon'
 listdisplayseparator='comma'><code event='defaultvalue'><formula>@If(ApproverRole = "[Leader1]";Leaders_1;
     ApproverRole = "[Leader2]";Leaders_2;
     ApproverRole = "[Leader3]";Leaders_3;
     ApproverRole = "[Leader4]";Leaders_4;
     ApproverRole = "[Leader5]";Leaders_5;
     ApproverRole = "[Director1]";Directors_1;
     ApproverRole = "[Director2]";Directors_2;
     ApproverRole = "[Director3]";Directors_3;
     ApproverRole = "[Director4]";Directors_4;
     ApproverRole = "[Director5]";Directors_5;
     "")</formula></code></field></run><run><font size='9pt' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30' color='red'/></run></par></tablecell></tablerow>
<tablerow>
