/P86AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAUAAAAAAAAAAQAAAAAAAAAAAAAAAAAA
AA==
</compositedata>
<par def='11'><run><font size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/> </run><run><font size='9pt' color='red' name='ＭＳ ゴシック'
