 pitch='fixed' truetype='true' familyid='30'/><field type='names' allowmultivalues='true'
 kind='computed' name='AgentUser' listinputseparators='comma semicolon' listdisplayseparator='comma'><code
 event='defaultvalue'><formula>List := @If(AgentRole = "[Agent1]";Agents_1;
               AgentRole = "[Agent2]";Agents_2;
               AgentRole = "[Agent3]";Agents_3;
               AgentRole = "[Agent4]";Agents_4;
               AgentRole = "[Agent5]";Agents_5;
               "");

@Trim(@Replace(List;ApproverUser;""))</formula></code></field></run><run><font
 size='9pt' name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30' color='red'/></run></par></tablecell></tablerow></table>
