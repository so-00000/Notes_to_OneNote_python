 pitch='fixed' truetype='true' familyid='30'/><field type='text' kind='computed'
 name='AgentRole'><code event='defaultvalue'><formula>No := @Left(@Right(ApplicantRole;2);1);

@If(ApplicantRole="";"";"[Agent" + No + "]")</formula></code></field></run><compositedata
 type='98' prevtype='65418' nexttype='222' afterparcount='9' containertype='65418'
 aftercontainercount='1' afterbegincount='3'>
Yg4BAIQAAAAAAAAAAAA=
