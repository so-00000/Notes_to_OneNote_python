 familyid='30'/><field type='names' allowmultivalues='true' kind='computed'
 name='ApplicantUser' listinputseparators='comma semicolon' listdisplayseparator='comma'><code
 event='defaultvalue'><formula>Author</formula></code></field></run><run><font
 name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30' color='red'/></run></par></tablecell></tablerow>
