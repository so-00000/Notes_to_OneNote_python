<action title='完了報告' icon='1' showinmenu='false'><code event='click'><formula
>REM {編集モードに切り替え};
@Command([EditDocument];"1");

REM {入力チェックの為、一旦保存};
@Command([FileSave]);

REM {********** 以下、入力チェック **********};
@If(System = "";
    @Do(@Command([EditGotoField];"System");
        MsgText := "システムが選択されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(DocumentDate = "";
    @Do(@Command([EditGotoField];"DocumentDate");
        MsgText := "発生日/受付日が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(@IsMember(Division;"問合せ":"データ強制変更":"保守") &amp;
    Ask = "";
    @Do(@Command([EditGotoField];"Ask");
        MsgText := "問合せ元/依頼元が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(@IsMember(Division;"障害":"問合せ":"データ強制変更":"保守") &amp;
    (File_Detail = "なし" | File_Detail = "");
    @Do(@Command([EditGotoField];"Detail");
        MsgText := "発生内容/問合せ内容/依頼内容が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; (File_Impact = "なし" | File_Impact = "");
    @Do(@Command([EditGotoField];"Impact");
        MsgText := "影響が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(@IsMember(Division;"障害":"データ強制変更":"保守") &amp;
    (File_Reason = "なし" | File_Reason = "");
    @Do(@Command([EditGotoField];"Reason");
        MsgText := "原因/理由が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");	
@If(Division = "障害" &amp; Measure_1 = "" &amp; Measure_2 = "";
    @Do(@Command([EditGotoField];"Measure_1");
        MsgText := "対策区分が選択されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; Measure_2 = "";
    @Do(@Command([EditGotoField];"Measure_2");
        MsgText := "恒久策【要・不要】が未登録です.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; Measure_2 = "要" &amp; Measure_2 = "不要";
    @Do(@Command([EditGotoField];"Measure_2");
        MsgText := "恒久策【要・不要】のどちらかにしてください.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");


@If(Division = "障害" &amp; @IsMember("暫定";Measure_1) &amp;
    (File_Temporary = "なし" | File_Temporary = "");
    @Do(@Command([EditGotoField];"Temporary");
        MsgText := "暫定策が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; @IsMember("暫定";Measure_1) &amp;
    Temporary_Plan = "";
    @Do(@Command([EditGotoField];"Temporary_Plan");
        MsgText := "対応予定日(暫定策)が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; @IsMember("暫定";Measure_1) &amp;
    Temporary_Comp = "";
    @Do(@Command([EditGotoField];"Temporary_Comp");
        MsgText := "対応完了日(暫定策)が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
REM {以下、完了報告時のみのチェック};
@If(Division = "障害" &amp; @IsMember("要";Measure_2) &amp;
    (File_Parmanent = "なし" | File_Parmanent = "");
    @Do(@Command([EditGotoField];"Parmanent");
        MsgText := "恒久策が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp; @IsMember("要";Measure_2) &amp;
    Parmanent_Plan = "";
    @Do(@Command([EditGotoField];"Parmanent_Plan");
        MsgText := "対応予定日(恒久策)が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "障害" &amp;
    Measure_2 = "";
    @Do(@Command([EditGotoField];"Parmanent_Plan");
        MsgText := "恒久対策未選択です.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "a障害" &amp; @IsMember("要";Measure_2) &amp;
    Parmanent_Comp = "";
    @Do(@Command([EditGotoField];"Parmanent_Comp");
        MsgText := "対応完了日(恒久策)が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "問合せ" &amp; (File_Reply = "なし" | File_Reply = "");
    @Do(@Command([EditGotoField];"Reply");
        MsgText := "回答が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "問合せ" &amp; ReplyDate= "";
    @Do(@Command([EditGotoField];"ReplyDate");
        MsgText := "回答日が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "データ強制変更" &amp;
    (File_Repair_Before = "なし" | File_Repair_Before = "");
    @Do(@Command([EditGotoField];"Repair_Before");
        MsgText := "変更前にファイルが添付されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "データ強制変更" &amp;
    (File_Repair_After = "なし" | File_Repair_After = "");
    @Do(@Command([EditGotoField];"Repair_After");
        MsgText := "変更後にファイルが添付されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "保守" &amp;
    (File_Maintenance = "なし" | File_Maintenance = "");
    @Do(@Command([EditGotoField];"Maintenance");
        MsgText := "保守対応詳細が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "保守" &amp;
    @IsNotMember("対応不要";ActionStatus) &amp;
    (File_TestSchedule = "なし" | File_TestSchedule = "");
    @Do(@Command([EditGotoField];"TestSchedule");
        MsgText := "テスト計画にファイルが添付されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "保守" &amp;
    @IsNotMember("対応不要";ActionStatus) &amp;
    (File_Reseption = "なし" | File_Reseption = "");
    @Do(@Command([EditGotoField];"Reseption");
        MsgText := "受入報告にファイルが添付されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(Division = "保守" &amp; @IsMember("要";OtherSystem) &amp; Release_Plan = "";
    @Do(@Command([EditGotoField];"Release_Plan");
        MsgText := "リリース予定日が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");	
@If(Division = "保守" &amp; Release_Comp = "";
    @Do(@Command([EditGotoField];"Release_Comp");
        MsgText := "リリース完了日が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");
@If(@IsMember(Division;"データ強制変更") &amp;
    CompreteDate = "";
    @Do(@Command([EditGotoField];"CompreteDate");
        MsgText := "完了日が入力されていません.";
        @Return(@Prompt([Ok];@DbTitle;MsgText)));
    "");	
REM {********** 以上、入力チェック **********};

REM {否認時の承認情報をクリア};
FIELD ApproveTime_2 := "";
FIELD ApproverDep_2 := "";
FIELD ApproverNm_2 := "";
FIELD ApproveStatus_2 := "";

FIELD Status := "完了報告中";
FIELD ReportTime_2 := @Now;
FIELD ReporterDep_2 := "(" + c_This_UserDept + ")";
FIELD ReporterNm_2 := c_This_UserNameJ;
@Command([FileSave]);

SendTo := ApproverUser;
Subject := "完了報告（" + Division + "）をお送りします. [" + @DbTitle + "]";
Body := "完了報告（" + Division + "）をお送りします." + @NewLine +
           "ご確認の上、承認いただけますようお願いします.";

@MailSend(SendTo;"";"";Subject;Body;"";[IncludeDoclink]);
@Command([CloseWindow])</formula></code><code event='hidewhen'><formula>NewRoles := "[Group" + @Right(ApplicantRole;2);
Status != "発生承認済" |
@Contains(ApplicantRole;"Leader") = @False |
@IsNotMember(NewRoles;@UserRoles)</formula></code></action>
