(@IsNotMember(@UserName;AgentUser) &amp; @IsNotMember(@UserName;@UpperCase(AgentUser)))</formula></code></action>
<action title='完了報告(代行)\否認' icon='11' showinmenu='false'><code event='click'><formula
>Ans := @Prompt([YesNo];@DbTitle;"否認してもよろしいですか?");
@If(Ans = @False;@Return("");"");

REM {編集モードに切り替え};
@Command([EditDocument];"1");

REM {入力チェック};
@If(@IsValid;"";@Return(""));

FIELD Status := "発生承認済";
FIELD ApproveTime_2 := @Now;
FIELD ApproverDep_2 := "(" + c_This_UserDept + ")";
FIELD ApproverNm_2 := c_This_UserNameJ;
FIELD ApproveStatus_2 := "否認(代行)";
@Command([FileSave]);

SendTo := ApplicantUser;
Subject := "完了報告（" + Division + "）を否認しました. [" + @DbTitle + "]";
Body := "完了報告（" + Division + "）を否認しました." + @NewLine +
           "ご確認願います.";

@MailSend(SendTo;"";"";Subject;Body;"";[IncludeDoclink]);
@Command([CloseWindow])</formula></code><code event='hidewhen'><formula>Status != "完了報告中" |
(@IsNotMember(@UserName;AgentUser) &amp; @IsNotMember(@UserName;@UpperCase(AgentUser)))</formula></code></action>
<action title='削除' icon='90' showinmenu='false'><code event='click'><formula
>Ans := @Prompt([YesNo];@DbTitle;"この文書を削除します. " + @Char(13) + "よろしいですか?");
@If(Ans = @False;@Return("");"");

@Command([EditDocument];"1");
FIELD DelFlg := "1";
@Command([FileSave]);
@Command([CloseWindow])</formula></code><code event='hidewhen'><formula>@IsNewDoc |
Status != "" |
(@IsNotMember(@UserName;ApplicantUser) &amp; @IsNotMember(@UserName;@UpperCase(ApplicantUser)))</formula></code></action>
<action title='経路更新' icon='145' showinmenu='false' hide='preview read'><code
 event='action'>
<simpleaction action='runagent' agent='(AGRoleCheck)'/></code><code event='hidewhen'
 enabled='false'><formula>@IsNewDoc |
Status = "完了承認済"|
@IsNotMember("[管理者]";@UserRoles)</formula></code></action>
<action title='保存終了' icon='117' showinmenu='false' hide='preview read'><code
 event='click'><lotusscript>Sub Click(Source As Button)
	Dim ws As New NotesUIWorkspace
	Dim uidoc As NotesUIDocument
	Dim doc As NotesDocument
	
	Set uidoc = ws.CurrentDocument
	Set doc = uidoc.Document
	
	doc.SaveFlag = "1"
	
	Call uidoc.Save
	Call uidoc.Close(True)
	
End Sub</lotusscript></code></action>
<action title='メール転送' icon='7' showinmenu='false'><code event='click'><formula
>@Command([EditMakeDocLink]);
@Command([MailComposeMemo]);
@Command([EditGotoField];"Subject");
No := @If(@IsNotMember(Division;"障害":"問合せ":"データ強制変更":"保守");"";
             "(管理番号:" + DpcumentNo + ")");

@Command([EditInsertText];"Fw: 食肉部門システム管理 - " + Division + No);
@Command([EditGotoField];"Body");
@Command([EditInsertText];@Repeat(@NewLine;8));
@Command([EditUp]);
@Command([EditUp]);
@Command([EditPaste])</formula></code><code event='hidewhen'><formula>@IsNewDoc</formula></code></action>
<action title='閉じる' icon='149' showinmenu='false'><code event='click'><formula
>@Command([CloseWindow])</formula></code></action></actionbar>
