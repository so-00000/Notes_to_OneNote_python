<globals><code event='options'><lotusscript>Option Public
Use "SLCommon"
</lotusscript></code></globals><code event='windowtitle'><formula>"食肉部門システム管理 - " + Division</formula></code><code
 event='postopen'><lotusscript>Sub Postopen(Source As Notesuidocument)
	'*** アクセス制御リストから承認者情報を取得する ***
	'---  表示状態で開いた場合は、承認者情報を取得しない（Exit Sub） ---
	If Source.EditMode = False Then
		Exit Sub
	End If
	
	'---  ステータス=「完了承認済」（＝完了分）は、承認者情報を取得しない（Exit Sub） ---
	Dim doc As NotesDocument
	Set doc = Source.Document
	If doc.Status(0) = "完了承認済" Then
		Exit Sub
	End If
	
	'--- スクリプトライブラリ「SLCommon」の「RoleCheck」を実行 ---
	Call RoleCheck
	
	'--- 表示を更新する ---
	Call Source.Refresh
End Sub
</lotusscript></code><code event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Call Source.Refresh( True )
	Call Source.RefreshHideFormulas
	Dim doc As NotesDocument
	Set doc = source.Document
	
	
	'■■■■■■■■　エラーチェック　■■■■■■■■
	If doc.Division(0) = "" Then
		Messagebox "分類が選択されていません.", 16, "食肉部門システム管理"
		Call Source.GotoField( "Division" )
		Continue = False
		Exit Sub
	End If
	
	If doc.System(0) = "" Then
		Messagebox "システムが選択されていません.", 16, "食肉部門システム管理"
		Call Source.GotoField( "System" )
		Continue = False
		Exit Sub
	End If
	
	If doc.DocumentDate(0) = "" Then
		Messagebox "発生日/受付日が入力されていません.", 16, "食肉部門システム管理"
		Call Source.GotoField( "DocumentDate" )
		Continue = False
		Exit Sub
	End If
	
	'****　問合せ ****	
	If Source.FieldGetText("Division") = "問合せ" Then
		'--- 発生起因 ---
		If Source.FieldGetText("syubetu_1") = "" Then
			Messagebox "発生起因が登録されていません。", 16, "食肉部門システム管理"
			Call Source.GotoField( "syubetu_1" )
			Continue = False
			Exit Sub
		Elseif Source.FieldGetText("WorkTime") = "" Then
			Messagebox "作業時間が登録されていません。", 16, "食肉部門システム管理"
			Call Source.GotoField( "WorkTime" )
			Continue = False
		End If	
	End If
	
	
End Sub</lotusscript></code>
