<tablecell>
<par def='10'><run><font name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30'
 color='red'/> ロール:</run><run><font color='red' name='ＭＳ ゴシック' pitch='fixed'
 truetype='true' familyid='30'/><field type='text' kind='computed' name='ApproverRole'><code
 event='defaultvalue'><formula>No := @Left(@Right(ApplicantRole;2);1);

@If(ApplicantRole="";"";
     @Contains(ApplicantRole;"Director");"[Director" + No + "]";
     @Contains(ApplicantRole;"Leader");"[Director" + No + "]";
     @Contains(ApplicantRole;"Group");"[Leader" + No + "]";
     "")</formula></code></field></run><compositedata type='98' prevtype='65418'
 nexttype='222' afterparcount='9' containertype='65418' aftercontainercount='1'
 afterbegincount='3'>
