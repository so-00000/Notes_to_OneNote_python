<action title='発生報告' icon='1' showinmenu='false' hide='preview read'><code
 event='click'><formula>REM {編集モードに切り替え};
@Command([EditDocument];"1");

REM {********** 以下、入力チェック **********};
@If(@Command([FileSave])=@Success;"";@Return(""));
REM {********** 以上、入力チェック **********};

REM {管理番号を取得};
@Command([ViewRefreshFields]);
No := No_Category_x + "-" + No_Num_x;
@If( DocumentNo = ""; DocumentNo:=@If(Division = "データ強制変更";"";No); "" );


REM {否認時の承認情報をクリア};
FIELD ApproveTime_1 := "";
FIELD ApproverDep_1 := "";
FIELD ApproverNm_1 := "";
FIELD ApproveStatus_1 := "";

FIELD Status := "発生報告中";
FIELD ReportTime_1 := @Now;
FIELD ReporterDep_1 := "(" + c_This_UserDept + ")";
FIELD ReporterNm_1 := c_This_UserNameJ;
@Command([FileSave]);

SendTo := ApproverUser;
Subject := "発生報告（" + Division + "）をお送りします. [" + @DbTitle + "]";
Body := "発生報告（" + Division + "）をお送りします." + @NewLine +
           "ご確認の上、承認いただけますようお願いします.";

@MailSend(SendTo;"";"";Subject;Body;"";[IncludeDoclink]);
@Command([CloseWindow])</formula></code><code event='hidewhen'><formula>Status != "" |
(@IsNotMember(@UserName;ApplicantUser) &amp; @IsNotMember(@UserName;@UpperCase(ApplicantUser)))</formula></code></action>
<action title='発生報告\承認' icon='127' showinmenu='false'><code event='click'><formula
>REM {編集モードに切り替え};
@Command([EditDocument];"1");

REM {入力チェック};
@If(@IsValid;"";@Return(""));

FIELD Status := @If(Division = "問合せ";"完了承認済";"発生承認済");
FIELD ApproveTime_1 := @Now;
FIELD ApproverDep_1 := "(" + c_This_UserDept + ")";
FIELD ApproverNm_1 := c_This_UserNameJ;
