<par def='101'><run><font style='bold' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30'/></run><button width='2in' widthtype='maximum' maxlines='1'
 wraptext='true' bgcolor='maroon'><code event='click'><formula>@SetField("Third_answer";Third_answer +  @NewLine  + "対応完了しました。")</formula></code><font
 style='bold' name='ＭＳ Ｐゴシック' pitch='variable' truetype='true' familyid='30'
 color='yellow'/>対応完了</button><run><font style='bold' name='ＭＳ ゴシック' pitch='fixed'
 truetype='true' familyid='30'/></run><button width='2in' widthtype='maximum'
 maxlines='1' wraptext='true' bgcolor='maroon'><code event='click'><formula
>RES:=@Prompt([YesNo];"【確認】対応完了";"対応を完了し、一次(二次)対応者へ対応完了のﾒｰﾙを送信します。問題ありませんか");

@If(RES=1;@SetField("status";"CLOSE");"");

View:="SendTo";
Key:=@If(Escalation_2="";Escalation_1;Escalation_2);

mailto:=@If(Second_Person="";acc_main;acc_main:Second_Person);
cc:=@DbLookup("":"Nocache";"";View;Key;4);

subject:="【ﾘｽﾄｱﾌｧｲﾙ削除完了】"+outline;
bodyw:=@NewLine+@NewLine+"以下に問合せ対応結果を添付します。";
@If(RES=1;@SetField("Third_answer";Third_answer +  @NewLine  + "ﾘｽﾄｱﾌｧｲﾙの削除が完了しました。");"");
@If(RES=1;@MailSend(mailto;cc;"";subject;bodyw;"";[IncludeDoclink]);"");

@If(RES=1;@PostedCommand([ViewRefreshFields]);"");
@If(RES=1;@PostedCommand([FileSave]);"");
@If(RES=1;@PostedCommand([FileCloseWindow]);"")</formula></code><font style='bold'
 name='ＭＳ Ｐゴシック' pitch='variable' truetype='true' familyid='30' color='yellow'/>ﾘｽﾄｱﾌｧｲﾙ削除完了</button><run
