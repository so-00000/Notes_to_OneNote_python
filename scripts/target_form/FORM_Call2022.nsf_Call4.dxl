View:="SendTo";
Key:=@If(Escalation_2="";Escalation_1;Escalation_2);

mailto:=Third_Person;
cc:=@If(Second_Person="";@DbLookup("":"Nocache";"";View;Key;4):acc_main;@DbLookup("":"Nocache";"";View;Key;4):acc_main:Second_Person);

subject:="【指示事項】"+outline;
bodyw:=@NewLine+@NewLine+"以下に問合せ対応内容に対しての上長のコメントを添付します。";
@If(RES=1;@MailSend(mailto;cc;"";subject;bodyw;"";[IncludeDoclink]);"");

@If(RES=1;@PostedCommand([ViewRefreshFields]);"");
@If(RES=1;@PostedCommand([FileSave]);"");
@If(RES=1;@PostedCommand([FileCloseWindow]);"")</formula></code>上長コメントを送信</button><run
