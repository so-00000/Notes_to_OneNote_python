 width='2in' widthtype='maximum' maxlines='1' wraptext='true' bgcolor='#00bfff'><code
 event='click'><formula>RES:=@Prompt([YesNo];"【確認】関連部門へ送信";"関連部門へｴｽｶﾚｰｼｮﾝのﾒｰﾙを送信します。問題ありませんか");

View:="SendTo";
Key:=Escalation_1;
@If(RES=1;@If(Key="";@Return(@Prompt([Ok];"ｴｽｶﾚｰｼｮﾝ先未選択";"関連部門のｴｽｶﾚｰｼｮﾝ先が選択されておりません。"));"");"");

@If(RES=1;@SetField("answer";answer + @NewLine + "ノーツ運用担当へﾘｽﾄｱﾌｧｲﾙの削除依頼");"");
@If(RES=1;@Command([ViewRefreshFields]);"");

mailto:=@DbLookup("":"Nocache";"";View;Key;2);
cc:=@DbLookup("":"Nocache";"";View;Key;3):@Name([CN];@UserName );
subject:="【ﾘｽﾄｱﾌｧｲﾙ削除依頼】"+outline;
