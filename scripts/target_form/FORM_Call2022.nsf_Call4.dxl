 maxlines='1' wraptext='true' bgcolor='system'><code event='click'><formula
>FIELD PCUMU:=PCUMU;
FIELD PCNAME:=PCNAME;
FIELD PCKAISHA:=PCKAISHA;
FIELD PCJIGYOU:=PCJIGYOU;
FIELD PCADDRESS:=PCADDRESS;
FIELD PCTEL:=PCTEL;
FIELD PCHKISYU:=PCHKISYU;
FIELD PCHMEKAR:=PCHMAKER;
FIELD PCSN_1:=PCSN_1;
@SetField("PCUMU";"有");
@SetField("PCNAME";customername_2);
@SetField("PCKAISHA";sec1);
@SetField("PCJIGYOU";sec3);
@SetField("PCADDRESS";ADDRESS1+ADDRESS2+ADDRESS3);
@SetField("PCTEL";tel);
@SetField("PCHKISYU";@Left(SEIHIN;"("));
@SetField("PCHMEKAR";HW);
@SetField("PCSN_1";PCSN)</formula></code><font size='9pt' style='bold' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30'/>再ｾｯﾄｱｯﾌﾟ</button><run><font
