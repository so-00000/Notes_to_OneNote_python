@If(RES=1;@MailSend(mailto;cc;"";subject;bodyw;"";[IncludeDoclink]);"");

@If(RES=1;@PostedCommand([FileSave]);"");
@If(RES=1;@PostedCommand([FileCloseWindow]);"")</formula></code><font name='ＭＳ Ｐゴシック'
