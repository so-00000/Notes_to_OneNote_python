 name='mng_no' listinputseparators='comma semicolon' listdisplayseparator='semicolon'><code
 event='defaultvalue'><formula>month:=@Text(@Month(@Now));
day:= @Text(@Day(@Now));
hour:=@Text(@Hour(@Now)) ;
minute:=@Text(@Minute(@Now));
second:=@Text(@Second(@Now));
@Set("month";@If(@Length( month)=1;"0"+month;month));
@Set("day";@If(@Length( day)=1;"0"+day;day));
@Set("hour";@If(@Length( hour)=1;"0"+hour;hour));
@Set("minute";@If(@Length( minute)=1;"0"+minute;minute));
@Set("second";@If(@Length( second)=1;"0"+second;second));

@RightBack(@Text(@Year(@Now)); 3) + month +day +@Environment("UserNo")+hour+minute+second</formula></code></field></run><compositedata
