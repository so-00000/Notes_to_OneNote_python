<par def='7'><run><font size='9pt' style='bold' name='ＭＳ ゴシック' pitch='fixed'
 truetype='true' familyid='30'/></run><button width='2in' widthtype='maximum'
 maxlines='1' wraptext='true' bgcolor='system'><code event='click'><formula
>month:=@Right("0"+@Text(@Month(@Now));2);
day:= @Right("0"+@Text(@Day(@Now));2);
hour:=@Right("0"+@Text(@Hour(@Now));2) ;
minute:=@Right("0"+@Text(@Minute(@Now));2);
second:=@Right("0"+@Text(@Second(@Now));2);

no:=@RightBack(@Text(@Year(@Now)); 3) + month +day +@Environment("UserNo")+hour+minute+second;
no_1:="新規コール受付（問題番号："+no+"）";

@SetField("mng_no";no);
@SetField("title";no_1);
@SetField("CreateDateTime";@Now);
@SetField("CreateDateTime_p";@Now);
@SetField("acc_main";c_This_UserNameJ );
@SetField("acc_name";c_This_UserNameJ );
@SetField("create_name";c_This_UserNameJ );
@SetField("lasthistory";"");
@SetField("es_nemew";"");
@SetField("SecondLinew";"");
@SetField("CloseDateTime";"");
@SetField("SDATE_Y";@Year(@Now));
@SetField("SDATE_M";@Month(@Now));
@SetField("SDATE_D";@Day(@Now));
@SetField("STIME_H";@Hour(@Now));
@SetField("STIME_M";@Minute(@Now));
@SetField("EDATE_Y";@Year(@Now));
@SetField("EDATE_M";@Month(@Now));
@SetField("EDATE_D";@Day(@Now));
@SetField("ETIME_H";@Hour(@Now));
@SetField("ETIME_M";@Minute(@Now))</formula></code><font name='ＭＳ Ｐゴシック' pitch='variable'
 truetype='true' familyid='30'/>問題番号変更</button><run><font size='9pt' style='bold'
 name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30' color='blue'/>&lt;&lt;==文書をコピーした場合、必ず</run><run
><font size='18pt' style='bold' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30' color='red'/>押す</run><run><font size='9pt' style='bold' name='ＭＳ ゴシック'
 pitch='fixed' truetype='true' familyid='30' color='blue'/>こと！！！　このボタンを押すと、新しい番号がセットされます。</run></par>
