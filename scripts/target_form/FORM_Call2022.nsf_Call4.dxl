<updatedby><name>CN=yukie hirata/O=NMP</name></updatedby>
<wassignedby><name>CN=yukie hirata/O=NMP</name></wassignedby><code event='windowtitle'><formula
>@If(@IsNewDoc ;"新規コール受付";outline+"  ("+mng_no+")  ")</formula></code><code
 event='postopen'><lotusscript>Sub Postopen(Source As Notesuidocument)
	status$ =source.FieldGetText("status")
	If source.EditMode Then    
		Call source.FieldSetText("status_open",status$)
		Call source.FieldSetText( "saveswich", "n")
	End If
End Sub
</lotusscript></code><code event='queryopen'><lotusscript>Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	
End Sub
</lotusscript></code><code event='queryclose'><lotusscript>Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	status$ =source.FieldGetText("status")
	openstatus$ =source.FieldGetText("status_open")
	accesscountText$ =source.FieldGetText("access_no")
	accesscount=Clng ( accesscountText$ )
	If status$=openstatus$ Then
		accesscount=accesscount
	Else
		accesscount=accesscount+1
	End If
	If accesscount=0 Then
		accesscount=1
	End If
	accesscountText$=Cstr (accesscount)
	
	
	
	saveswich$ =source.FieldGetText("saveswich")
 '編集中かどうか確認    
	If source.EditMode Then    
		Call source.FieldSetText("access_no", accesscountText$)
		
          '更新する場合のみ処理
		If saveswich$="y" Then
                '履歴情報の設定  
			Select Case status$
			Case "引継ぎ依頼中": name1 ="-" &amp; source.FieldGetText("es_namew")
			Case "セカンドライン回答待ち": name1 ="-" &amp; source.FieldGetText("SecondLinew")
			Case Else    : name1 =""
			End Select
			
			acc_name$ =source.FieldGetText("acc_name")
			lasthistory$ = source.FieldGetText("lasthistory")
			editdate =Format(Now(), "yyyy/mm/dd h:mm")
			history =editdate &amp; " " &amp; acc_name$ &amp; " " &amp;  status$  &amp; name1 &amp;"," &amp;lasthistory$
			Call source.FieldSetText("lasthistory", history)
			
               '完了までの経過時間の設定
			closedatetime$ = source.FieldGetText("CloseDateTime")
			If status$ ="CLOSE" Then
				If closedatetime$ =""  Then
					Call source.FieldSetText("CloseDateTime", Cstr ( Now() ))
				End If
			Else
				If closedatetime$ ="" Then
				Else     
					Call source.FieldSetText("CloseDateTime", "")
				End If
			End If
			Call source.Save
		End If
	End If
End Sub
</lotusscript></code><code event='postmodechange'><lotusscript>Sub Postmodechange(Source As Notesuidocument)
	
	status$ =source.FieldGetText("status")
	If source.EditMode Then    
		Call source.FieldSetText("status_open",status$)
		Call source.FieldSetText( "saveswich", "n")
	End If
End Sub
</lotusscript></code><code event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Call source.FieldSetText( "saveswich", "y")
	
End Sub</lotusscript></code>
