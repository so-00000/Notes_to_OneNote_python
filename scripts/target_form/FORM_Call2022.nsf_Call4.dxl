 afterbegincount='3'>
Yg4BAIQAAAAAAAAAAAA=
</compositedata><run><font style='bold' name='ＭＳ ゴシック' pitch='fixed' truetype='true'
 familyid='30'/></run><button width='2in' widthtype='maximum' maxlines='1'
 wraptext='true' bgcolor='system'><code event='click'><formula>allitemw:=@DbLookup("":"NoCache";DbLookupServer_1 :CustomDBname_1 ; "N.HELPJCD" ;customerno;4);
allitem:=@Explode(allitemw;";");
no:=@Subset(allitem;1);
namew:=@Subset(allitem;2);
name:=@Subset(namew;-1);
kanaw:=@Subset(allitem;3);
kana:=@Subset(kanaw;-1);
sec1w:=@Subset(allitem;4);
sec1:=@Subset(sec1w;-1);
sec2w:=@Subset(allitem;5);
sec2:=@Subset(sec2w;-1);
sec3w:=@Subset(allitem;6);
sec3:=@Subset(sec3w;-1);
telw:=@Subset(allitem;7);
tel:=@Subset(telw;-1);
address1w:=@Subset(allitem;8);
address1:=@Subset(address1w;-1);
address2w:=@Subset(allitem;9);
address2:=@Subset(address2w;-1);
address3w:=@Subset(allitem;10);
address3:=@Subset(address3w;-1);
BUMONw:=@Subset(allitem;11);
BUMON:=@Subset(BUMONw;-1);
KAISHAw:=@Subset(allitem;12);
KAISHA:=@Subset(KAISHAw;-1);
KAISHACDw:=@Subset(allitem;14);
KAISHACD:=@Subset(KAISHACDw;-1);
@SetField("customerno";no);
@SetField("kana";kana);

REM {@SetField("customername";name+"("+@Left(@Right(customername;"(");")")+")")};
@SetField("customername";name);
@SetField("SEC1";sec1);
@SetField("SEC2";sec2);
@SetField("SEC3";sec3);
@SetField("tel";tel);
@SetField("ADDRESS1";address1);
@SetField("ADDRESS2";address2);
@SetField("ADDRESS3";address3);
@SetField("BUMON";BUMON);
@SetField("KAISHA";KAISHA);
@SetField("customercompanycd";"0" + KAISHACD)</formula></code><font style='bold'
 name='ＭＳ ゴシック' pitch='fixed' truetype='true' familyid='30'/>確定</button><run
