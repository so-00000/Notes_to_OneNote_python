					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top;' data-hidewhen='!(@Contains(@UserRoles;&quot;[HELP]&quot;) | @Contains(@UserRoles;&quot;[莠梧ｬ｡]&quot;) | @Contains(@UserRoles;&quot;[髢｢騾｣]&quot;) | @Contains(@UserRoles;&quot;[謳ｺ蟶ｯ莉望&quot;))'>
						<div class='notes-par'><span class='notes-field-wrap'><span class='notes-field' data-field='answer' data-type='text' data-kind='editable'>{{answer}}</span></span>
						</div>
						<div class='notes-par'><span style='font-weight:bold;'>謳ｺ蟶ｯ逡ｪ蜿ｷｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='keitaitel' data-type='text' data-kind='editable'>{{keitaitel}}</span></span><span style='font-weight:bold;'>縲蜃ｦ逅莉ｶ謨ｰｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='Processing_number' data-type='text' data-kind='editable'>{{Processing_number}}</span></span>
						</div>
						<div class='notes-par'><span style='font-weight:bold;'>ｾ奇ｾ滂ｽｽｾ懶ｽｰｾｾ</span><span style='font-weight:bold;'>ｾ会ｽｰｾゑｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='pass' data-type='text' data-kind='editable'>{{pass}}</span></span><span style='font-weight:bold;'>ADｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='pass_1' data-type='text' data-kind='editable'>{{pass_1}}</span></span><span style='font-weight:bold;'>縺昴ｮ莉厄ｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='pass_2' data-type='text' data-kind='editable'>{{pass_2}}</span></span>
