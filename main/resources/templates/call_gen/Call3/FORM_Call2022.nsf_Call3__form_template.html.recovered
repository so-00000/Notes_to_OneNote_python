<!-- source_dxl: C:\Users\SLY\Documents\Python螳滄ｨ貼Python - OneNote\Git\Notes_to_OneNote_python\scripts\target_form\FORM_Call2022.nsf_Call3.dxl -->

<style>
.notes-form{font-family:MS PGothic,Meiryo,'Segoe UI',Arial,sans-serif;font-size:11pt;line-height:1.45;color:#222;}
.notes-form table{border-collapse:collapse; width:800px; table-layout:fixed;}
.notes-form td,.notes-form th{border:1px solid #808080; padding:3px 6px; vertical-align:top;}
.notes-form th{background:#efefef;font-weight:normal;}
.notes-form .notes-par{margin:2px 0;font-weight:bold;display:block;width:100%;box-sizing:border-box;}
.notes-form .notes-field-wrap{display:block;width:100%;box-sizing:border-box;}
.notes-form .notes-field{display:block;width:100%;min-width:0;min-height:1.2em;border:1px solid #666;background:#fff;padding:1px 4px;border-radius:2px;box-sizing:border-box;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;}
.notes-form .notes-field[data-kind='computed'],
.notes-form .notes-field[data-kind='computedfordisplay'],
.notes-form .notes-field[data-kind='computedwhencomposed']{background:#f7f7f7;color:#555;}
.notes-form .notes-link{color:#0645ad;text-decoration:underline;}
.notes-form .notes-subform{border:1px dashed #aaa;padding:6px;margin:6px 0;background:#fafafa;}
.notes-form .notes-subform-title{font-weight:bold;margin-bottom:4px;}
.notes-form .notes-section{border:1px solid #a0a0a0;margin:6px 0;}
.notes-form .notes-section-title{background:#d9d9d9;padding:2px 6px;font-weight:bold;}
.notes-form .notes-section-body{padding:4px 6px;}
.notes-form .notes-textlist{display:block;margin-left:1em;}

</style>
<div class='notes-form' data-design='繧ｳ繝ｼ繝ｫ蜿嶺ｻ(謾ｹ3) (Call3)'>
	<div class='notes-subform'>
		<div class='notes-subform-title'>SUBFORM: SubUserInfo (missing DXL)
		</div>
	</div><br/>
	<div class='notes-section' data-hidewhen='@IsNewDoc'>
		<div class='notes-section-body'>
			<div class='notes-section-title' style='margin-top:1em;'>荳谺｡蟇ｾ蠢
			</div><br/>
			<div class='notes-par'><span class='notes-field-wrap'><span class='notes-field' data-field='Title' data-type='text' data-kind='computedwhencomposed'>{{Title}}</span></span><span style='font-weight:bold;'>ｼ2022蟷ｴ蠎ｦｼ</span>
			</div><br/>
			<div class='notes-par'><span style='font-weight:bold;'>繝ｦ繝ｼ繧ｶ繝ｼ逡ｪ蜿ｷｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='customerno' data-type='text' data-kind='editable'>{{customerno}}</span></span><span style='font-weight:bold;'>莨夂､ｾCDｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='customercompanycd' data-type='text' data-kind='editable'>{{customercompanycd}}</span></span>
			</div>
			<table style='margin-top:1em; border-collapse:collapse; width:800px; table-layout:fixed;' width='800' border='1' cellspacing='0' cellpadding='0'>
				<tr>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top; background:#e9f3ff; font-weight:bold; width:120px;'>
						<div class='notes-par'><span style='font-weight:bold;'>蜿嶺ｻ倬幕蟋</span>
						</div>
					</td>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top;' colspan='3'>
						<div class='notes-par'><span class='notes-field-wrap'><span class='notes-field' data-field='SDATE_Y' data-type='number' data-kind='editable'>{{SDATE_Y}}</span></span><span style='font-weight:bold;'> 蟷ｴｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='SDATE_M' data-type='number' data-kind='editable'>{{SDATE_M}}</span></span><span style='font-weight:bold;'> 譛茨ｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='SDATE_D' data-type='number' data-kind='editable'>{{SDATE_D}}</span></span><span style='font-weight:bold;'> 譌･ｼ茨ｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='STIME_H' data-type='text' data-kind='editable'>{{STIME_H}}</span></span><span style='font-weight:bold;'> 譎ゑｼ</span><span class='notes-field-wrap'><span class='notes-field' data-field='STIME_M' data-type='text' data-kind='editable'>{{STIME_M}}</span></span><span style='font-weight:bold;'> 蛻ｼ</span>
						</div>
					</td>
				</tr>
				<tr>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top; background:#e9f3ff; font-weight:bold; width:120px;'>
						<div class='notes-par'><span style='font-weight:bold;'>莠区･ｭ謇蜷</span>
						</div>
					</td>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top;'>
						<div class='notes-par'><span class='notes-field-wrap'><span class='notes-field' data-field='customername' data-type='text' data-kind='editable' data-allowmultivalues='true'>{{customername}}</span></span>
						</div>
					</td>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top; background:#e9f3ff; font-weight:bold;'>
						<div class='notes-par'><span style='font-weight:bold;'>莠区･ｭ謇蜷搾ｼ医き繝奇ｼ</span>
						</div>
					</td>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top;'>
