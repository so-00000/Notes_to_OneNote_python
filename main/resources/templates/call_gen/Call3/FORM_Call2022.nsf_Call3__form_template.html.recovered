				</tr>
				<tr data-hidewhen='!(@Contains(@UserRoles;&quot;[HELP]&quot;) | @Contains(@UserRoles;&quot;[莠梧ｬ｡]&quot;) | @Contains(@UserRoles;&quot;[髢｢騾｣]&quot;) | @Contains(@UserRoles;&quot;[謳ｺ蟶ｯ莉望&quot;))'>
					<td style='border:1px solid #808080; padding:3px 6px; vertical-align:top; background:#e9f3ff; font-weight:bold; width:120px;'>
						<div class='notes-par'><span style='font-weight:bold;'>隱ｿ縲縲譟ｻ</span>
						</div>
						<div class='notes-par'><span style='font-weight:bold;'>謫堺ｽ懈焔鬆</span>
						</div>
