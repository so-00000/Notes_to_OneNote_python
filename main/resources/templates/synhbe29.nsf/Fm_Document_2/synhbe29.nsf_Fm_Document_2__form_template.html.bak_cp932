						<span class='notes-field' data-field='Agenda_Text' data-type='text'>{{Agenda_Text}}</span>
					</span>
				</div>
				<div class='notes-par'>
					<span class='notes-field-wrap'>
						<span class='notes-field' data-field='Agenda' data-type='richtext'>{{Agenda}}</span>
					</span>
				</div>
			</td>
		</tr>
	</table>
</div>
